# ==============================================================================
# Sirkula — Root .gitignore
# ==============================================================================

# ─── Environment Variables & Secrets ──────────────────────────
.env
.env.*
*.env
*.env.*
# Izinkan file template/example agar developer lain & server tahu formatnya
!.env.example
!.env*.example
!*.env.example
!*.env*.example

# ─── Python & Virtual Environments ────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
venv/
.venv/
env/
ENV/
pip-wheel-metadata/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*pyrefly.toml

# ─── Node.js & Next.js (Admin Dashboard) ──────────────────────
node_modules/
.next/
admin/.next/
admin/out/
admin/build/
*.tsbuildinfo
admin/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Flutter / Dart (Mobile App) ──────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
mobile/.dart_tool/
mobile/build/
mobile-app/build/
mobile/package-lock.json

# Android
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/**/.cxx/
mobile/android/.kotlin/
*.iml
.idea/

# iOS / macOS
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/macos/Flutter/ephemeral/
mobile/macos/Pods/
mobile/macos/.symlinks/

# Windows / Linux desktop flutter
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/

# ─── File Uploads, Database & Runtime Data ─────────────────────
uploads/*
backend/uploads/*
!backend/uploads/**/.gitkeep
postgres_data/
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# ─── Editor & OS System Files ─────────────────────────────────
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ─── Model & Raw Dataset Files ────────────────────────────────
# Abaikan grafik analisis dan dataset raw, izinkan model serialisasi .pkl
model/*.png
model/*.csv
!model/*.pkl

# ─── Dokumen & Aset Riset Internal TA ─────────────────────────
data/
design/
doc/
