# ========================================
# Sirkula Backend — Production Environment
# ========================================
# Copy this file to .env and fill in the values.

# App Environment
FLASK_ENV=production
FLASK_DEBUG=0

# Database (PostgreSQL)
DATABASE_URL=postgresql://sirkula_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/sirkula

# JWT Secret (MUST change — minimum 32 characters)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ML Service (internal, same server)
ML_SERVICE_URL=http://127.0.0.1:5001

# CORS — allowed origins (comma-separated)
CORS_ORIGINS=https://sirkula.tech

# File Uploads
UPLOAD_FOLDER=/opt/sirkula/backend/uploads
MAX_CONTENT_LENGTH=6291456
