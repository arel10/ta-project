[Unit]
Description=Sirkula Next.js Admin Dashboard
After=network.target sirkula-backend.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/sirkula/admin
Environment="NODE_ENV=production"
Environment="NEXT_PUBLIC_API_URL=https://sirkula.tech/api"
ExecStart=/usr/bin/npx next start -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
