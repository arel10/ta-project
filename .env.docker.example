# ==============================================================================
# Sirkula — Docker Compose Production Environment Variables
# Salin file ini menjadi .env sebelum menjalankan 'docker compose up -d'
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_DB=sirkula
POSTGRES_USER=sirkula_user
POSTGRES_PASSWORD=GantiPasswordPostgresAman123!

# Security Keys (minimal 32 karakter acak)
JWT_SECRET_KEY=sirkula_jwt_secret_key_super_aman_minimal_32_karakter_bebas

# Public URL (sesuaikan dengan domain VPS)
NEXT_PUBLIC_API_URL=https://sirkula.tech/api
CORS_ORIGINS=https://sirkula.tech,https://www.sirkula.tech
